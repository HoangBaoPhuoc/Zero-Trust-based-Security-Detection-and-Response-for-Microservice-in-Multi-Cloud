{
  "realm": "ztlab",
  "enabled": true,
  "displayName": "ZTLab",
  "sslRequired": "external",
  "accessTokenLifespan": 300,
  "ssoSessionMaxLifespan": 36000,
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpPolicyLookAheadWindow": 1,
  "clients": [
    {
      "clientId": "api-gateway",
      "protocol": "openid-connect",
      "publicClient": false,
      "authorizationServicesEnabled": true,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://api.ztlab.local/*",
        "https://api-gateway.ztlab.local/*"
      ],
      "webOrigins": [
        "+"
      ],
      "protocolMappers": [
        {
          "name": "aud-api-gateway",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "api-gateway",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "web-portal",
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://portal.ztlab.local/*",
        "http://portal.ztlab.local:8080/*",
        "http://localhost:8080/*",
        "http://localhost:5000/*",
        "http://localhost:18081/*",
        "http://127.0.0.1:8080/*",
        "http://127.0.0.1:5000/*",
        "http://127.0.0.1:18081/*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "aud-api-gateway",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "api-gateway",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "web-portal-stepup",
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://portal.ztlab.local/*",
        "http://portal.ztlab.local:8080/*",
        "http://localhost:8080/*",
        "http://localhost:5000/*",
        "http://localhost:18081/*",
        "http://127.0.0.1:8080/*",
        "http://127.0.0.1:5000/*",
        "http://127.0.0.1:18081/*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "acr.loa.map": "{\"1\": 1, \"high\": 2}"
      },
      "protocolMappers": [
        {
          "name": "aud-api-gateway",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "api-gateway",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "aws-console-sso",
      "protocol": "saml",
      "attributes": {
        "saml.assertion.signature": "true",
        "saml_name_id_format": "email",
        "saml_signature_canonicalization_method": "http://www.w3.org/2001/10/xml-exc-c14n#"
      },
      "redirectUris": ["https://signin.aws.amazon.com/saml"],
      "protocolMappers": [
        {
          "name": "role-list",
          "protocol": "saml",
          "protocolMapper": "saml-role-list-mapper",
          "config": {
            "single": "false",
            "attribute.nameformat": "Basic",
            "attribute.name": "https://aws.amazon.com/SAML/Attributes/Role"
          }
        }
      ]
    },
    {
      "clientId": "aws-console-sso",
      "protocol": "saml",
      "attributes": {
        "saml.assertion.signature": "true",
        "saml_name_id_format": "email",
        "saml_signature_canonicalization_method": "http://www.w3.org/2001/10/xml-exc-c14n#"
      },
      "redirectUris": ["https://signin.aws.amazon.com/saml"],
      "protocolMappers": [
        {
          "name": "role-list",
          "protocol": "saml",
          "protocolMapper": "saml-role-list-mapper",
          "config": {
            "single": "false",
            "attribute.nameformat": "Basic",
            "attribute.name": "https://aws.amazon.com/SAML/Attributes/Role"
          }
        }
      ]
    },
    {
      "clientId": "siem-backend",
      "protocol": "openid-connect",
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "financial-read"
      },
      {
        "name": "financial-write"
      },
      {
        "name": "security-analyst"
      },
      {
