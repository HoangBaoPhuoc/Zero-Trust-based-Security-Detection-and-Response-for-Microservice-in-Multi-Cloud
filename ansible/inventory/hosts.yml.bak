all:
  vars:
    ansible_user: ubuntu
    ansible_ssh_private_key_file: "{{ lookup('env', 'SSH_KEY') | default('~/.ssh/ztlab-key', true) }}"
    ansible_host_key_checking: false

  children:
    ssh_entrypoints:
      hosts:
        aws_bastion:
          ansible_host: 47.129.154.174
        aws_gateway:
          ansible_host: 13.228.93.165
          wg_tunnel_ip: "10.200.0.1"
          wg_peer_routes: "192.168.100.0/24,192.168.101.0/24,192.168.102.0/24"

    aws_private:
      vars:
        ansible_ssh_common_args: >-
          -o ProxyJump=ubuntu@47.129.154.174
          -o StrictHostKeyChecking=no
          -o UserKnownHostsFile=/dev/null
      hosts:
        aws_k3s_master:   { ansible_host: 10.10.1.10 }
        aws_k3s_worker_1: { ansible_host: 10.10.1.11 }
        aws_k3s_worker_2: { ansible_host: 10.10.1.12 }
        aws_security:     { ansible_host: 10.10.1.20 }

    aws_monitoring:
      vars:
        ansible_ssh_common_args: >-
          -o ProxyJump=ubuntu@47.129.154.174
          -o StrictHostKeyChecking=no
          -o UserKnownHostsFile=/dev/null
      hosts:
        aws_loki: { ansible_host: 10.10.2.10 }

    openstack:
      vars:
        ansible_ssh_common_args: '-o StrictHostKeyChecking=no'
        cloud_provider: "openstack"    # dùng trong promtail-config.yml.j2
      children:
        os_dmz:
          hosts:
            os_gateway:
              ansible_host: 172.10.10.100  # OpenStack floating IP
              wg_tunnel_ip: "10.200.0.2"
              wg_peer_routes: "10.10.1.0/24,10.10.2.0/24,10.10.4.0/24"
        os_private:
          vars:
            ansible_ssh_common_args: >-
              -o ProxyJump=ubuntu@172.10.10.100
              -o StrictHostKeyChecking=no
              -o UserKnownHostsFile=/dev/null
          hosts:
            os_k3s_master:   { ansible_host: 192.168.101.11 }  # OpenStack private IP
            os_k3s_worker_1: { ansible_host: 192.168.101.12 }
            os_k3s_worker_2: { ansible_host: 192.168.101.13 }

    aws:
      vars:
        cloud_provider: "aws"    # dùng trong promtail-config.yml.j2
      children:
        ssh_entrypoints:
        aws_private:
        aws_restricted:
